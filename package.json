{
  "name": "opsflow-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server in Node.js for read-only SQL analytics, dataset freshness checks, workflow playbooks, and JSON-RPC evals",
  "type": "module",
  "license": "MIT",
  "author": "Nasim Uddin (@Nasim-U)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nasim-U/opsflow-mcp.git"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "opsflow-mcp": "./src/cli.mjs"
  },
  "scripts": {
    "test": "node --test tests/opsflow.test.mjs",
    "eval": "node src/evals.mjs",
    "demo": "node src/cli.mjs demo",
    "serve:stdio": "node src/cli.mjs serve-stdio",
    "serve:http": "node src/cli.mjs serve-http"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "workflow-automation",
    "analytics-engineering",
    "sql-guardrails",
    "sqlite",
    "llm-tools",
    "evals"
  ]
}
